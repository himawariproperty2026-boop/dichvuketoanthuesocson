# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION - DỊCH VỤ KẾ TOÁN THUẾ SÓC SƠN
# Sao chép file này thành .env.local để điền các giá trị môi trường thật
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH GỬI EMAIL THÔNG BÁO FORM LIÊN HỆ (SMTP / EMAIL SERVICE)
# ------------------------------------------------------------------------------
# Phương thức gửi email: 'smtp' hoặc 'resend' hoặc 'webhook'
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="Dịch vụ Kế toán Sóc Sơn <no-reply@dichvuketoanthuesocson.com.vn>"
EMAIL_TO_NOTIFY="contact@dichvuketoanthuesocson.com.vn"

# Hoặc nếu dùng dịch vụ Webhook (nhận thông báo Zalo / Telegram Bot / n8n / Make)
WEBHOOK_NOTIFICATION_URL="https://your-webhook-endpoint.com/api/notify"

# ------------------------------------------------------------------------------
# 2. THÔNG BÁO TỨC THÌ QUA ZALO PLATFORM CHATBOT / ZALO OA API / TELEGRAM
# ------------------------------------------------------------------------------
# Cấu hình kết nối trực tiếp Zalo OpenAPI v3.0 (nhận tại https://developers.zalo.me)
ZALO_OA_ACCESS_TOKEN="your-zalo-oa-access-token"
ZALO_RECEIVER_ID="your-zalo-user-id-to-receive-notifications"

# Hoặc Nền Tảng Zalo Chatbot Webhook (Ahachat, Fchat, Botcake, Hana.ai, n8n, Make)
ZALO_WEBHOOK_URL="https://your-zalo-chatbot-platform.com/webhook/endpoint"

TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-telegram-chat-id"

# ------------------------------------------------------------------------------
# 2. CHỐNG SPAM & BẢO MẬT (GOOGLE RECAPTCHA V3 - TÙY CHỌN)
# ------------------------------------------------------------------------------
# Nhận key tại: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your-recaptcha-site-key"
RECAPTCHA_SECRET_KEY="your-recaptcha-secret-key"

# ------------------------------------------------------------------------------
# 3. GOOGLE ANALYTICS, GTM & FACEBOOK PIXEL
# ------------------------------------------------------------------------------
# Mã Google Analytics 4 (ví dụ: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Mã Google Tag Manager (ví dụ: GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# Mã Facebook Pixel ID (ví dụ: 123456789012345)
NEXT_PUBLIC_FB_PIXEL_ID="123456789012345"

# ------------------------------------------------------------------------------
# 4. BỘ ĐẾM LƯỢT TRUY CẬP THẬT (VERCEL KV / UPSTASH REDIS)
# ------------------------------------------------------------------------------
# Nút đếm lượt truy cập footer sẽ tự động HIỂN THỊ nếu 2 biến dưới đây được cấu hình.
# Nếu để trống, khối đếm lượt truy cập sẽ TỰ ĐỘNG ẨN để tránh hiển thị số giả.
KV_REST_API_URL="https://your-kv-db.upstash.io"
KV_REST_API_TOKEN="your-kv-rest-api-token"

# ------------------------------------------------------------------------------
# 5. TỰ ĐỘNG ĐĂNG BÀI BLOG SEO TỪ N8N (/api/n8n/publish)
# ------------------------------------------------------------------------------
# Khóa bảo mật x-api-key cho node "Publish To Website" trong n8n
N8N_API_KEY="n8n_secret_token_2026_ketoansocson"

# GitHub Personal Access Token (quyền Contents: Read & Write) để API tự động commit
# bài viết mới vào content/blog/*.md giúp Vercel tự build & cập nhật sitemap.xml
GITHUB_TOKEN="ghp_your_github_personal_access_token"
GITHUB_REPO="himawariproperty2026-boop/dichvuketoanthuesocson"
GITHUB_BRANCH="main"
